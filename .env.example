# Backend Configuration
PORT=3001
NODE_ENV=development  # development | production

# Frontend Configuration (prefixo VITE_ é obrigatório)
# Essas variáveis são expostas ao frontend em build time

# DESENVOLVIMENTO: Use URLs absolutas para servidor dev separado
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# PRODUÇÃO: Use URLs relativas (backend serve o frontend)
# VITE_API_URL=
# VITE_WS_URL=ws://localhost:3001
