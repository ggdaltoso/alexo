# O Alexo lê DOIS arquivos .env -- copie este para os dois lugares:
#
#   .env            (raiz)  backend, ao iniciar (backend/config.js)
#   frontend/.env           Vite, na hora do BUILD e na máquina que builda.
#                           O deploy builda no computador de desenvolvimento e
#                           envia só o dist, então as VITE_ do .env do Pi não
#                           têm efeito nenhum.
#
# Cada lado ignora as variáveis do outro.

# Backend
PORT=3001
NODE_ENV=development  # development | production

# Frontend (prefixo VITE_ é obrigatório; o valor vai embutido no bundle)
# Vazios servem para tudo: no dev o proxy do Vite repassa /api, /uploads e /ws;
# em produção a página usa o host de onde veio. Não ponha localhost aqui: no
# bundle, localhost é a máquina do navegador, e só a tela do Pi acertaria.
VITE_API_URL=
VITE_WS_URL=

# Todoist API Token
# Obtenha em: https://app.todoist.com/app/settings/integrations
VITE_TODOIST_API_TOKEN=your_todoist_api_token_here
